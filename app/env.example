# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=13378
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:13378    # what phones and the web player connect to
SSL_PROXY=0                          # 1 behind DSM's reverse proxy (which then does HTTPS)
ABS_IMAGE=ghcr.io/advplyr/audiobookshelf:2.37.1   # a release, pinned; the window offers newer ones
ADMIN_USER=you                       # your account, Audiobookshelf's root user (its password is never stored; it's shown once)
ABS_KEY=…                            # the package's API key for the window's work ("DSM package" in Audiobookshelf → Settings → API Keys)
# Library folder places (up to four of each). BOOKS_n is the folder on the NAS, read-only;
# BOOKS_n_SRC/_DST are what's mounted: the folder at its own path, or nothing (a placeholder) while it's missing.
BOOKS_1="/volume1/audiobooks"
BOOKS_1_SRC="/volume1/audiobooks"
BOOKS_1_DST="/volume1/audiobooks"
PODCASTS_1="/volume1/podcasts"       # podcast folders are writable: new episodes are downloaded into them
PODCASTS_1_SRC="/volume1/podcasts"
PODCASTS_1_DST="/volume1/podcasts"
